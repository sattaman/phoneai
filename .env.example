# Copy to .env and fill in. Never commit .env.

# LiveKit Cloud (cloud.livekit.io -> Settings -> API keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenRouter (set a spend limit on the key)
OPENROUTER_API_KEY=

# Twilio Elastic SIP trunk (termination URI + credential list) and caller ID
TWILIO_SIP_DOMAIN=            # e.g. my-trunk.pstn.twilio.com
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
TWILIO_PHONE_NUMBER=          # E.164 caller ID

# Optional: Google Calendar -> Settings -> your calendar -> "Secret address in iCal format"
GOOGLE_CALENDAR_ICAL_URL=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=phoneai-dev

# Optional overrides
# OWNER_NAME=Tom
# TIMEZONE=Europe/London
# MAX_CALL_SECONDS=300
